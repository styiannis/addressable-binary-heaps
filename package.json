{
  "name": "addressable-binary-heaps",
  "version": "1.1.0",
  "description": "A versatile TypeScript library for addressable binary heaps, delivering optimized and scalable min-heap and max-heap implementations, seamlessly supporting both object-oriented and functional paradigms.",
  "keywords": [
    "data structures",
    "binary heap",
    "binary heaps",
    "heap",
    "heaps",
    "max heap",
    "min heap"
  ],
  "author": "Yiannis Stergiou <hello@styiannis.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/styiannis/addressable-binary-heaps.git"
  },
  "bugs": {
    "url": "https://github.com/styiannis/addressable-binary-heaps.git"
  },
  "type": "commonjs",
  "source": "src/index.ts",
  "main": "dist/cjs/index.cjs",
  "module": "dist/es/index.mjs",
  "types": "dist/@types/cjs/index.d.cts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.12.0",
    "npm": ">=8.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "warn"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scripts": {
    "build": "node ./scripts/clear.cjs ./dist && rollup -c",
    "dev": "node ./scripts/clear.cjs ./dist && rollup -c --watch",
    "check-declared-paths": "node ./scripts/check-declared-paths.cjs",
    "check-dist-loads": "node ./scripts/check-dist-loads.cjs",
    "check-types": "tsc --noEmit",
    "check-updates": "npx npm-check-updates@23",
    "clear": "node ./scripts/clear.cjs ./build ./code_documentation ./coverage_report ./dist",
    "docs": "node ./scripts/clear.cjs ./code_documentation && typedoc --basePath ./ --entryPoints src/index.ts --entryPointStrategy Expand --readme none --includeVersion --out code_documentation --name \"Addressable Binary Heaps\"",
    "format": "prettier -w ./",
    "lint": "oxlint --deny-warnings ./",
    "prepack": "npm i && npm run build",
    "reset": "npm run clear && node ./scripts/clear.cjs ./node_modules",
    "reset-hard": "npm run reset && node ./scripts/clear.cjs ./package-lock.json ./yarn.lock ./pnpm-lock.yaml",
    "test": "jest",
    "test-coverage": "node ./scripts/clear.cjs ./coverage_report && jest --coverage --coverageDirectory=coverage_report",
    "test-coverage-watch": "npm run test-coverage -- --watchAll",
    "test-watch": "jest --watchAll",
    "verify": "npm run check-types && npm run lint && npm run build && npm run check-declared-paths && npm run check-dist-loads"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/@types/es/index.d.mts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./max-heap": {
      "import": {
        "types": "./dist/@types/es/core/max-heap.d.mts",
        "default": "./dist/es/core/max-heap.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/core/max-heap.d.cts",
        "default": "./dist/cjs/core/max-heap.cjs"
      }
    },
    "./min-heap": {
      "import": {
        "types": "./dist/@types/es/core/min-heap.d.mts",
        "default": "./dist/es/core/min-heap.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/core/min-heap.d.cts",
        "default": "./dist/cjs/core/min-heap.cjs"
      }
    }
  }
}
